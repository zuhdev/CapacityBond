{
  "name": "capacitybond",
  "version": "0.1.0",
  "private": true,
  "description": "Reservation-level native-BOT assurance for compute commitments made elsewhere.",
  "engines": {
    "node": ">=20.19.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @capacitybond/web",
    "build": "npm run build -w @capacitybond/web",
    "preview": "npm run preview -w @capacitybond/web",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "test": "npm run test:contracts && npm run test --workspaces --if-present",
    "test:contracts": "hardhat test",
    "compile": "hardhat compile",
    "deploy:bohr": "hardhat run scripts/deploy.ts --network bohr",
    "seed:bohr": "hardhat run scripts/seed-demo.ts --network bohr",
    "accept:bohr": "hardhat run scripts/acceptance.ts --network bohr",
    "gas:report": "hardhat run scripts/gas-report.ts",
    "keys:generate": "tsx scripts/generate-local-keys.ts"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "2.1.2",
    "@nomicfoundation/hardhat-ethers": "3.1.3",
    "@nomicfoundation/hardhat-network-helpers": "1.1.2",
    "@openzeppelin/contracts": "5.6.1",
    "@types/chai": "4.3.20",
    "@types/mocha": "10.0.10",
    "@types/node": "20.19.43",
    "chai": "4.5.0",
    "ethers": "6.16.0",
    "hardhat": "2.29.1",
    "mocha": "11.8.0",
    "solc": "0.8.28",
    "ts-node": "10.9.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
