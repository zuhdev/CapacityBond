# Local deployment only. Copy to .env and keep it out of git.

# --- Testnet (Bohr, chain 968) ---
BOHR_RPC_URL=https://rpc.bohr.life
BOHR_CHAIN_ID=968
BOHR_EXPLORER_URL=https://scan.bohr.life

# --- Mainnet (BOT Chain, chain 677) ---
BOT_MAINNET_RPC_URL=https://rpc.botchain.ai
# Explicit confirmation is required for every mainnet deployment.
DEPLOY_CONFIRM_MAINNET=
# Explicit confirmation is required for the optional mainnet acceptance run.
ACCEPT_MAINNET=

# Never commit real keys. These testnet-only keys are generated by `npm run keys:generate`.
# For a mainnet deployment, use production keys from a hardware wallet instead.
DEPLOYER_PRIVATE_KEY=
ATTESTOR_ADDRESS=
RESOLVER_ADDRESS=
BUYER_ADDRESS=
GRACE_PERIOD_SECONDS=300

# Seed / acceptance runners only. Local burner accounts funded by the deployer.
BUYER_PRIVATE_KEY=
ATTESTOR_PRIVATE_KEY=
RESOLVER_PRIVATE_KEY=
