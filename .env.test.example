# Frontend build-time values. Never place private keys in VITE_* variables.
VITE_CAPACITY_BOND_ADDRESS=
# The default build targets BOT Chain mainnet. Set "testnet" to build a
# Bohr testnet bundle (deployments/bohr.json).
VITE_BOND_NETWORK=
# Optional endpoint override.
VITE_RPC_URL=
# Legacy testnet-only override, kept for compatibility.
VITE_BOHR_RPC_URL=
